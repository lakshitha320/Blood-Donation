					"raw": "{\n    \"bloodType\": \"O-\",\n    \"amount\": 5,\n    \"timestamp\": \"2026-08-16T09:15:00Z\"\n}"
				},
				"url": {
					"raw": "{{base_url}}/inventory/update",
					"host": [
						"{{base_url}}"
					],
					"path": [
						"inventory",
						"update"
					]
				}
			},
			"response": []
		},
		{
