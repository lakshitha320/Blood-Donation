	"item": [
		{
			"name": "1. Get all Inventory",
			"request": {
				"method": "GET",
				"header": [
					{
						"key": "X-API-KEY",
						"value": "{{api_key}}",
						"type": "text"
					}
				],
				"url": {
					"raw": "{{base_url}}/inventory",
					"host": [
						"{{base_url}}"
					],
					"path": [
						"inventory"
					]
				}
			},
			"response": []
		},
		{
			"name": "2. Get Inventory by Blood Type",
			"request": {
				"method": "GET",
				"header": [
					{
						"key": "X-API-KEY",
						"value": "{{api_key}}",
						"type": "text"
					}
				],
				"url": {
					"raw": "{{base_url}}/inventory/{{blood_type}}",
					"host": [
						"{{base_url}}"
					],
					"path": [
						"inventory",
						"{{blood_type}}"
					]
				}
			},
			"response": []
		},
		{
