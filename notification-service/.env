# Database Configuration
MONGO_URI=mongodb://localhost:27017/notification_db

# Security Configuration
API_KEY=my-secret-api-key-12345

# Notification Behaviour
# Keep true for demos/marking - no real SMTP/SMS account needed, everything is logged.
NOTIFICATION_MOCK_MODE=true
SMS_PROVIDER=mock

# Optional real email delivery (only used when NOTIFICATION_MOCK_MODE=false)
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
