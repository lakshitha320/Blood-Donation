{
  "info": {
    "name": "Notification Service",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "baseUrl", "value": "http://localhost:8085" },
    { "key": "apiKey", "value": "my-secret-api-key-12345" }
  ],
  "item": [
    {
      "name": "Send Email Notification",
      "request": {
        "method": "POST",
        "header": [
          { "key": "X-API-KEY", "value": "{{apiKey}}" },
          { "key": "Content-Type", "value": "application/json" }
        ],
        "url": "{{baseUrl}}/notify/email",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"recipientId\": \"donor123\",\n  \"recipientEmail\": \"donor@example.com\",\n  \"subject\": \"Thank you for donating!\",\n  \"message\": \"Your donation has been recorded. Thank you for saving lives.\"\n}"
        }
      }
    },
    {
      "name": "Send SMS Notification",
      "request": {
        "method": "POST",
        "header": [
          { "key": "X-API-KEY", "value": "{{apiKey}}" },
          { "key": "Content-Type", "value": "application/json" }
        ],
        "url": "{{baseUrl}}/notify/sms",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"recipientId\": \"donor123\",\n  \"recipientPhone\": \"+94771234567\",\n  \"message\": \"Reminder: you are eligible to donate blood again.\"\n}"
        }
      }
    },
    {
      "name": "Broadcast Alert",
      "request": {
        "method": "POST",
        "header": [
          { "key": "X-API-KEY", "value": "{{apiKey}}" },
          { "key": "Content-Type", "value": "application/json" }
        ],
        "url": "{{baseUrl}}/notify/alerts",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"channel\": \"EMAIL\",\n  \"subject\": \"Urgent: O- Blood Needed\",\n  \"message\": \"A hospital in your area urgently needs O- blood.\",\n  \"bloodType\": \"O-\",\n  \"location\": \"Colombo\",\n  \"recipientContacts\": [\"donor1@example.com\", \"donor2@example.com\"]\n}"
        }
      }
    },
    {
      "name": "Get All Notifications",
      "request": {
        "method": "GET",
        "header": [ { "key": "X-API-KEY", "value": "{{apiKey}}" } ],
        "url": "{{baseUrl}}/notify"
      }
    },
    {
      "name": "Get Notification By ID",
      "request": {
        "method": "GET",
        "header": [ { "key": "X-API-KEY", "value": "{{apiKey}}" } ],
        "url": "{{baseUrl}}/notify/REPLACE_WITH_ID"
      }
    },
    {
      "name": "Get Notifications By Recipient",
      "request": {
        "method": "GET",
        "header": [ { "key": "X-API-KEY", "value": "{{apiKey}}" } ],
        "url": "{{baseUrl}}/notify/recipient/donor123"
      }
    }
  ]
}
